{{/* Pizza Tracker dashboard regions, rendered server-side and streamed over SSE.
     html/template auto-escapes interpolated values. */}}

{{- define "badge" -}}
<span class="vb {{versionClass .}}">{{.}}</span>
{{- end -}}

{{- define "order" -}}
<div class="order{{if .Failing}} fail{{end}}{{if .Done}} done{{end}}" id="order-{{.ID}}">
  <div class="oh">
    {{- /* Illustrations are <symbol>s of the sprite in index.html, so fragments pushed over SSE reuse them. */ -}}
    <svg class="pz" aria-hidden="true"><use href="#{{pizzaIcon .Pizza}}"/></svg>
    {{- template "badge" .Version -}}
    {{- if .Failing}}<button class="recover-btn" type="button" title="Recover {{.ID}}" aria-label="Recover {{.ID}}"
            hx-post="/orders/{{.ID}}/recover" hx-target="#toast" hx-swap="innerHTML" hx-target-error="#toast"
            hx-disabled-elt="this">Fix</button>{{end -}}
    <b>#{{.ID}}</b>
    {{- if .Pizza}}<span class="nm">{{.Pizza}}</span>{{end -}}
    <span class="el">{{elapsed .ElapsedSec}}</span>
  </div>
  <div class="stepper" style="{{stepperStyle .}}">
    {{- range stepNodes . -}}
    <div class="node {{.Class}} {{.Icon}}">
      <div class="dot"><svg aria-hidden="true"><use href="#{{.Icon}}"/></svg></div>
      <div class="lbl">{{.Label}}</div>
    </div>
    {{- end -}}
  </div>
</div>
{{- end -}}

{{- define "orders" -}}
{{- range .Orders}}{{template "order" .}}{{end -}}
{{- if and .OrdersPaused (not .Orders) -}}
<div class="orders-empty" id="orders-paused">
  <svg class="orders-empty-art" aria-hidden="true"><use href="#pizza-box-sleeping"/></svg>
  <p>Order publishing is paused.</p>
</div>
{{- end -}}
{{- end -}}

{{- define "version" -}}
{{- /* . is a VersionCard */ -}}
<div class="ver{{if eq .Status "INACTIVE"}} inactive{{end}}" id="ver-{{.Version}}">
  <div class="vrow">
    {{- template "badge" .Version -}}
    {{- $chipID := printf "chip-%s-%s-%d" .Version .Status .TrafficPct -}}
    {{- if eq .Status "CURRENT"}}<span id="{{$chipID}}" class="chip c-cur">CURRENT</span>
    {{- else if eq .Status "RAMPING"}}<span id="{{$chipID}}" class="chip c-ramp">RAMPING {{.TrafficPct}}%</span>
    {{- else if eq .Status "DRAINING"}}<span id="{{$chipID}}" class="chip c-drain">DRAINING</span>
    {{- else}}<span id="{{$chipID}}" class="chip c-inact">INACTIVE</span>{{end -}}
  </div>
  <div class="bar"><span id="bar-{{.Version}}" class="{{versionClass .Version}}"
       style="--bar-w:{{barWidth .TrafficPct}}%"></span></div>
  <div class="pin">{{.PinnedCount}} in flight</div>
</div>
{{- end -}}

{{- define "versions" -}}
{{- range .Versions -}}{{template "version" .}}{{end -}}
{{- end -}}

{{- define "controls" -}}
{{- /* . is a DashboardState. Both buttons are hidden with fewer than two versions; Rollback is disabled
       unless a version is ramping. When hidden the region renders nothing at all (not even whitespace),
       so the .controls:empty CSS rule collapses the row. */ -}}
{{- if hasMultipleVersions .Versions -}}
<button class="btn primary" type="button"
        hx-get="/deploy" hx-target="#modal-host" hx-swap="innerHTML"
        hx-target-error="#toast">Deploy</button>
<button class="btn danger" type="button"
        hx-get="/rollback" hx-target="#modal-host" hx-swap="innerHTML"
        hx-target-error="#toast"{{if not (hasRamping .Versions)}} disabled{{end}}>Rollback</button>
{{- end -}}
{{- end -}}

{{- define "publishing" -}}
{{- /* . is a DashboardState. The stable button id lets idiomorph morph it in place across states. */ -}}
{{- if .OrdersPaused -}}
<button id="publishing-toggle" class="pub-btn paused" type="button" aria-pressed="true"
        title="Start new orders again"
        hx-delete="/pause" hx-swap="none" hx-target-error="#toast" hx-disabled-elt="this">
  <span class="pub-dot" aria-hidden="true"></span>Resume orders
</button>
{{- else -}}
<button id="publishing-toggle" class="pub-btn" type="button" aria-pressed="false"
        title="Stop starting new orders"
        hx-put="/pause" hx-swap="none" hx-target-error="#toast" hx-disabled-elt="this">
  <span class="pub-dot" aria-hidden="true"></span>Pause orders
</button>
{{- end -}}
{{- end -}}

{{- define "toast" -}}
<div class="toast show">{{.Message}}</div>
{{- end -}}

{{- define "deploy-modal" -}}
<div class="modal-scrim" hx-delete="/modal" hx-target="#modal-host" hx-swap="innerHTML"
     hx-trigger="keyup[key=='Escape'] from:body">
  <form class="modal" role="dialog" aria-modal="true" aria-label="Deploy a version"
        hx-post="/deploy" hx-target="#modal-host" hx-swap="innerHTML" hx-target-error="#toast">
    <h3>Deploy</h3>
    <div class="modal-lbl">Target version</div>
    <div class="radios">
      {{- range .Versions}}
      <label class="radio">
        <input type="radio" name="version" value="{{.Version}}"{{if .Checked}} checked{{end}}
               hx-get="/deploy/ramp" hx-target="#deploy-ramp" hx-swap="outerHTML" />
        <span class="vb {{versionClass .Version}}">{{.Version}}</span>
      </label>
      {{- end}}
    </div>
    {{- template "deploy-ramp" .Ramp -}}
    <p class="modal-note">At 100% this promotes the version to Current.</p>
    <div class="modal-acts">
      <button class="btn" type="button" hx-delete="/modal" hx-target="#modal-host" hx-swap="innerHTML">Cancel</button>
      <button class="btn primary" type="submit">Apply</button>
    </div>
  </form>
</div>
{{- end -}}

{{- define "deploy-ramp" -}}
<div id="deploy-ramp">
  <div class="modal-lbl">Ramping <span class="pct">{{.Pct}}%</span></div>
  <input class="stepper-range" type="range" name="stop" min="0" max="2" step="1" value="{{.StopIdx}}"
         list="deploy-stops"
         hx-get="/deploy/ramp" hx-trigger="change" hx-include="input[name='version']:checked"
         hx-target="#deploy-ramp" hx-swap="outerHTML" />
  <datalist id="deploy-stops">
    <option value="0"></option>
    <option value="1"></option>
    <option value="2"></option>
  </datalist>
</div>
{{- end -}}

{{- define "rollback-modal" -}}
<div class="modal-scrim" hx-delete="/modal" hx-target="#modal-host" hx-swap="innerHTML"
     hx-trigger="keyup[key=='Escape'] from:body">
  <div class="modal" role="dialog" aria-modal="true" aria-label="Confirm rollback">
    <h3>Roll back?</h3>
    <p class="modal-note">This reverts traffic to the previously Current version.</p>
    <div class="modal-acts">
      <button class="btn" type="button" hx-delete="/modal" hx-target="#modal-host" hx-swap="innerHTML">Cancel</button>
      <button class="btn danger" type="button"
              hx-post="/rollback" hx-target="#modal-host" hx-swap="innerHTML" hx-target-error="#toast">Roll back</button>
    </div>
  </div>
</div>
{{- end -}}
